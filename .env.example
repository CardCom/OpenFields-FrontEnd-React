# OpenFieldsTester - one file per CardCom environment: copy to .env.<name> (e.g. .env.prod)
# and run `npm run dev -- --env=<name>`. These files hold API credentials and are
# git-ignored; only this example is committed.
#
# BEFORE YOU START: contact CardCom support and request a TEST COMPANY with a TEST TERMINAL.
# Put its terminal number and API user below and experiment there - never on a live terminal:
# every approved payment is a real charge.

# CardCom server, no trailing slash. The app builds <host>/api/v11 (backend) and
# <host>/api/OpenFields (iframes) from it.
CARDCOM_HOST=https://secure.cardcom.solutions

# Test terminal + API user from CardCom support (see above).
TERMINAL_NUMBER=1000
API_NAME=YourApiName
API_PASSWORD=YourApiPassword

# Amount per payment, ILS (default 1)
AMOUNT=1

# Optional
# SERVER_PORT=8000
# WEB_PORT=5173
# Where CardCom posts the webhook - must be reachable from the CardCom server (e.g. an ngrok tunnel).
# Default https://example.com (CardCom rejects localhost webhooks, error 5170). The tester does not
# need it: results come back by postMessage and GetLpResult.
# PUBLIC_BASE_URL=https://your-tunnel.example.com
