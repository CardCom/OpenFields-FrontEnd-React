{
  "name": "openfields-tester",
  "private": true,
  "version": "0.2.0",
  "description": "CardCom OpenFields tester: a merchant checkout (React + Vite) and backend (Fastify) that runs against any CardCom environment from one .env.<environment> file",
  "type": "module",
  "workspaces": [
    "apps/*",
    "server"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:prod": "node scripts/dev.mjs --env=prod",
    "build": "npm run build -w apps/web",
    "test": "node scripts/test.mjs",
    "test:prod": "node scripts/test.mjs --env=prod",
    "report": "playwright show-report"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
